# Reviewer login, sent via HTTP Basic Auth (example values only; replace locally).
# Both must be set or the API fails closed with 503 - an unset password never
# means "no authentication".
APP_USERNAME=reviewer
APP_PASSWORD=change-me

# Language-model provider. Base URL must stop at the version root - the client
# appends /chat/completions itself. Any OpenAI-compatible endpoint works, but
# the model id has to match what that endpoint expects: OpenRouter ids carry a
# provider prefix, api.openai.com ids do not.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-5.6-luna

# Who writes the answer text. "composed" (the default) means application code
# writes every word from the computed results, so a hallucinated figure is
# impossible by construction. "verified" lets the agent write its own synthesis
# across several tool calls, but only after every number in it has been traced
# back to a computed result; anything unverifiable falls back to composed prose.
ASK_NARRATION=composed

# Path is resolved from the backend process working directory
DATA_CSV_PATH=mock_logistics_data.csv

# Frontend origin allowed by CORS (frontend runs on port 3001)
FRONTEND_ORIGIN=http://localhost:3001

# Langfuse tracing for Ask Operations (Stream G). Optional: tracing is skipped
# entirely, with no error, when either key is unset. Set LANGFUSE_ENABLED=false
# to force it off even with keys present, or =true to force it on.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Self-hosted or region-specific Langfuse instance. Leave unset for Langfuse's
# default cloud host.
LANGFUSE_BASE_URL=
LANGFUSE_ENABLED=
# Environment label attached to every trace (e.g. development/staging/production)
LANGFUSE_TRACING_ENVIRONMENT=development
# Optional JSON object of extra labels attached to every trace as tags +
# metadata (org, project, owner, ...) - shows up in the Langfuse UI per trace.
CUSTOM_TAGS={"org":"spaceship","project":"dashboard-logistic","developer":"hasnan"}
# Query observations always include the structured request and computed result
# table. Set this to true only when raw filtered shipment rows are also safe to
# export to Langfuse (they can contain sensitive operational data).
LANGFUSE_INCLUDE_QUERY_SOURCE_ROWS=false
