# Where the FastAPI backend is running
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# HTTP Basic credentials - must match APP_USERNAME/APP_PASSWORD on the backend
NEXT_PUBLIC_API_USERNAME=reviewer
NEXT_PUBLIC_API_PASSWORD=change-me

# "api" uses the real backend; "fixtures" renders sample data with no backend
NEXT_PUBLIC_DATA_MODE=api
